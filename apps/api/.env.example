# Copy to .env (git-ignored) and set your own password.
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://pa_app:change-me@localhost:5432/physics_anatomy_dev
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:3000/api

# Sign-in emails are written to the log locally (ADR 0038). No provider is chosen yet.
EMAIL_DELIVERY=log

# Google sign-in stays off unless both are set. Never commit real values.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Required in preview, staging and production: the header the proxy puts the client's address in.
# CLIENT_IP_HEADER=cf-connecting-ip
