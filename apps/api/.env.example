# Copy to .env (git-ignored) and set your own password.
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://pa_app:change-me@localhost:5432/physics_anatomy_dev
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:3000/api

# Accounts (ADR 0047): off by default everywhere. Off, the sign-in, class, live, sync, privacy
# export and AI routes answer 404. The web app and the admin portal read the same setting.
ACCOUNTS_ENABLED=false

# Sign-in emails are written to the log locally (ADR 0038). Deployed servers use Resend:
# EMAIL_DELIVERY=resend, RESEND_API_KEY from the secret store, EMAIL_FROM on the verified domain.
EMAIL_DELIVERY=log
# RESEND_API_KEY=
# EMAIL_FROM=Physics Anatomy <sign-in@your-domain>

# Cloudflare Turnstile on the sign-in and join forms: off locally, required when deployed with
# accounts on.
# TURNSTILE_SECRET_KEY=

# Google sign-in stays off unless both are set. Never commit real values.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Required in preview, staging and production: the header the proxy puts the client's address in.
# CLIENT_IP_HEADER=cf-connecting-ip

# The admin API (ADR 0040). Deployed: both from the Cloudflare Access application; never commit them.
# CF_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
# CF_ACCESS_AUDIENCE=<the admin application's audience tag>
# Optional second check behind the Access policy, as a JSON list:
# ADMIN_STAFF_EMAILS=["you@example.org"]
# Local only (refused anywhere else): every admin call counts as this staff member.
ADMIN_DEV_BYPASS_EMAIL=dev@localhost
# Optional read replica for the admin charts:
# ADMIN_DATABASE_URL=

# AI (ADR 0043): off unless switched on. The key comes only from the secret store; never commit it.
# Deployed servers with AI on also need AI_LOG_KEY, a long random string for the log's pseudonyms.
AI_ENABLED=false
# ANTHROPIC_API_KEY=
# AI_LOG_KEY=
# The model for each feature (defaults shown):
# AI_MODEL_TUTOR=claude-haiku-5-5
# AI_MODEL_WHAT_IF=claude-haiku-5-5
# AI_MODEL_REPORT_REVIEW=claude-sonnet-5-5
# AI_MODEL_QUESTION_DRAFTING=claude-sonnet-5-5
# Daily quotas (docs/content/ai-quotas-brief.md) are settings too, as JSON, for example
# AI_QUOTA_STUDENT={"tutor": 30, "what-if": 15, "report-review": 5}
# AI_REQUESTS_PER_ADDRESS=1500
# AI replies one person may have under way at once.
# AI_REQUESTS_AT_ONCE=2
# The day's spend in US dollars at which AI stops until midnight: the monthly AI ceiling / 30.
# Required on deployed servers with AI on.
# AI_DAILY_BUDGET_USD=
