# Copy to .env (git-ignored) and set your own password.
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://pa_app:change-me@localhost:5432/physics_anatomy_dev
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:3000/api

# Sign-in emails are written to the log locally (ADR 0038). Deployed servers use Resend:
# EMAIL_DELIVERY=resend, RESEND_API_KEY from the secret store, EMAIL_FROM on the verified domain.
EMAIL_DELIVERY=log
# RESEND_API_KEY=
# EMAIL_FROM=Physics Anatomy <sign-in@your-domain>

# Cloudflare Turnstile on the sign-in and join forms: off locally, required when deployed.
# TURNSTILE_SECRET_KEY=

# Google sign-in stays off unless both are set. Never commit real values.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Required in preview, staging and production: the header the proxy puts the client's address in.
# CLIENT_IP_HEADER=cf-connecting-ip

# The admin API (ADR 0040). Deployed: both from the Cloudflare Access application; never commit them.
# CF_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
# CF_ACCESS_AUDIENCE=<the admin application's audience tag>
# Optional second check behind the Access policy, as a JSON list:
# ADMIN_STAFF_EMAILS=["you@example.org"]
# Local only (refused anywhere else): every admin call counts as this staff member.
ADMIN_DEV_BYPASS_EMAIL=dev@localhost
# Optional read replica for the admin charts:
# ADMIN_DATABASE_URL=
