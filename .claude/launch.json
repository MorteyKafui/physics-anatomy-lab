{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "--cwd", "apps/web", "dev"],
      "port": 3000
    },
    {
      "name": "admin",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "--cwd", "apps/admin", "dev"],
      "port": 3001
    },
    {
      "name": "web-build",
      "runtimeExecutable": "bunx",
      "runtimeArgs": ["--cwd", "apps/web", "next", "start", "--port", "3100"],
      "port": 3100
    },
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "apps/api",
        "fastapi",
        "dev",
        "app/main.py",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "admin-build",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "--cwd", "apps/admin", "start"],
      "port": 3001
    }
  ]
}
