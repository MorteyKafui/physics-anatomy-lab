# The voice provider spike's keys. Copy this file to .env (it is git-ignored) and fill in the
# providers you have accounts with; leave the others empty. Never commit the real file.

# Microsoft Azure Speech: a Speech resource's key and region (for example, westeurope).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional: exact voices to try, comma-separated (for example, en-NG-EzinneNeural).
AZURE_VOICES=

# Google Cloud Text-to-Speech: an API key restricted to the Text-to-Speech API.
GOOGLE_TTS_API_KEY=
# Optional: exact voices to try, comma-separated.
GOOGLE_VOICES=

# GhanaNLP Khaya (Twi, Ewe, Ga): the key from translation.ghananlp.org.
KHAYA_API_KEY=
