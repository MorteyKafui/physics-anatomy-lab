{
  "name": "physics-anatomy",
  "version": "0.0.0",
  "private": true,
  "description": "Physics from first principles: a virtual physics lab with a coach, for SHS to university.",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run typecheck lint test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "bun run --cwd e2e e2e"
  },
  "overrides": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "eslint": "^9",
    "fast-check": "^4",
    "prettier": "^3",
    "turbo": "^2",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1"
  }
}
